---
// 地图卡片：列表页复用
interface Props {
  map: {
    id: string;
    zh: { name: string };
    en: { name: string };
    coordinates: string;
    displayIcon: string;
  };
}
const { map } = Astro.props;
---
<a class="card-cut card-lift map-card" href={`/maps/${map.id}/`}>
  <img src={map.displayIcon} alt={map.zh.name} loading="lazy" onerror="this.src='/favicon.svg'" />
  <div class="map-card__name">{map.zh.name}</div>
  <div class="map-card__sub">{map.en.name}</div>
</a>

<style>
  .map-card { display: block; padding: 1rem; text-align: center; }
  .map-card img { width: 100%; aspect-ratio: 1 / 0.625; object-fit: cover; margin-bottom: 0.5rem; transition: transform 0.25s ease; }
  .map-card:hover img { transform: scale(1.05); }
  .map-card__name { font-weight: 800; }
  .map-card__sub { font-size: 0.75rem; color: var(--val-gray); }
</style>