---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import matchesData from '../../data/matches.json';
import { teamZh, eventZh, seriesZh, dateZh } from '../../utils/esports-zh';

interface Match { href: string; teamA: string; teamB: string; scoreA: number | null; scoreB: number | null; winner: 'A' | 'B' | null; status: string; time: string; event: string; series: string; date: string; }
const all = (matchesData as { matches: Match[] }).matches;
const live = all.filter((m) => m.status === 'live');
const upcoming = all.filter((m) => m.status === 'upcoming');
const completed = all.filter((m) => m.status === 'completed');

const statusZh = (s: string) => (s === 'upcoming' ? '未开始' : s === 'live' ? '进行中' : '已结束');

// 按日期分组（数据本身按时间排序，同日相邻归组）
type DayGroup = { date: string; label: string; isToday: boolean; matches: Match[] };
const groupByDate = (list: Match[]): DayGroup[] => {
  const days: DayGroup[] = [];
  for (const m of list) {
    const last = days[days.length - 1];
    if (last && last.date === m.date) last.matches.push(m);
    else {
      const { label, isToday } = dateZh(m.date);
      days.push({ date: m.date, label, isToday, matches: [m] });
    }
  }
  return days;
};
const upcomingDays = groupByDate(upcoming);
const completedDays = groupByDate(completed.slice(0, 20));
---
<BaseLayout title="赛程赛果｜无畏契约资料站" description="VCT 赛程与赛果日历：按日期分组，中文赛事表述，数据每日自动同步">
  <PageHero label="Matches" title="赛程赛果" subtitle={`${all.length} 场比赛 · 日历式赛程 · 数据源 vlr.gg 每日同步`} />
  <main class="container section">
    {live.length > 0 && (
      <section class="role-group">
        <h2>正在直播</h2>
        {live.map((m) => (
          <div class="card-cut mt-row mt-row--live">
            <div class="mt-row__time"><span class="mt-live">LIVE</span></div>
            <div class="mt-row__main">
              <div class="mt-row__vs">
                <b>{teamZh(m.teamA)}</b>
                <span class="mt-row__vslabel">VS</span>
                <b>{teamZh(m.teamB)}</b>
              </div>
              <div class="mt-row__meta"><span class="mt-row__event">{eventZh(m.event)}{m.series ? ` · ${seriesZh(m.series)}` : ''}</span></div>
            </div>
          </div>
        ))}
      </section>
    )}

    <section class="role-group">
      <h2>赛程日历</h2>
      {upcomingDays.length === 0 ? <p class="page-sub">暂无排期，等待赛程公布</p> : upcomingDays.map((day) => (
        <div class="mt-day-group">
          <h3 class:list={['mt-day', { 'mt-day--today': day.isToday }]}>{day.isToday ? `今天 · ${day.label}` : day.label}</h3>
          {day.matches.map((m) => (
            <div class="card-cut mt-row">
              <div class="mt-row__time">{m.time}</div>
              <div class="mt-row__main">
                <div class="mt-row__vs">
                  <b>{teamZh(m.teamA)}</b>
                  <span class="mt-row__vslabel">VS</span>
                  <b>{teamZh(m.teamB)}</b>
                </div>
                <div class="mt-row__meta">
                  <span class="mt-row__status">{statusZh(m.status)}</span>
                  <span class="mt-row__event">{eventZh(m.event)}{m.series ? ` · ${seriesZh(m.series)}` : ''}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </section>

    <section class="role-group">
      <h2>最近赛果</h2>
      {completedDays.length === 0 ? <p class="page-sub">暂无已结束比赛记录</p> : completedDays.map((day) => (
        <div class="mt-day-group">
          <h3 class="mt-day">{day.label}</h3>
          {day.matches.map((m) => (
            <div class="card-cut mt-row">
              <div class="mt-row__time">{m.time}</div>
              <div class="mt-row__main">
                <div class="mt-row__vs">
                  <b class={m.winner === 'A' ? 'mt-win' : ''}>{teamZh(m.teamA)}</b>
                  <span class="mt-row__score">{m.scoreA} : {m.scoreB}</span>
                  <b class={m.winner === 'B' ? 'mt-win' : ''}>{teamZh(m.teamB)}</b>
                </div>
                <div class="mt-row__meta">
                  <span class="mt-row__status">{statusZh(m.status)}</span>
                  <span class="mt-row__event">{eventZh(m.event)}{m.series ? ` · ${seriesZh(m.series)}` : ''}</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      ))}
    </section>
    <p class="data-meta">赛程数据来自 vlr.gg，每日自动同步；开赛时间为 vlr.gg 所示时区；队名与赛事名为社区通行叫法，以官方为准。</p>
  </main>
</BaseLayout>

<style>
  .mt-day-group { margin-bottom: 1.4rem; }
  .mt-day { margin: 0 0 0.6rem; font-size: 0.92rem; font-weight: 800; color: var(--val-cream); border-left: 3px solid var(--val-red); padding-left: 0.6rem; }
  .mt-day--today { color: var(--val-red); }
  .mt-row { display: flex; align-items: center; gap: 1rem; padding: 0.65rem 0.9rem; margin-bottom: 0.5rem; min-width: 0; }
  .mt-row--live { border-color: var(--val-red); }
  .mt-row__time { flex-shrink: 0; width: 4.6rem; color: var(--val-cream); font-weight: 800; font-size: 0.88rem; }
  .mt-row__main { flex: 1; min-width: 0; }
  .mt-row__vs { display: flex; align-items: center; gap: 0.8rem; }
  .mt-row__vs b { color: var(--val-cream); font-size: 0.95rem; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mt-row__vs b:last-of-type { text-align: right; }
  .mt-row__vslabel, .mt-row__score { flex-shrink: 0; color: var(--val-red); font-size: 0.78rem; font-weight: 800; letter-spacing: 1px; }
  .mt-row__score { font-size: 0.92rem; }
  .mt-row__meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem; }
  .mt-row__status { flex-shrink: 0; color: rgba(236, 232, 225, 0.5); font-size: 0.65rem; border: 1px solid var(--val-line); padding: 1px 6px; border-radius: 4px; }
  .mt-row__event { color: var(--val-gray); font-size: 0.68rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mt-win { color: #FF4655 !important; text-shadow: 0 0 12px rgba(255, 70, 85, 0.45); }
  .mt-live { display: inline-block; background: #FF4655; color: #fff; font-size: 0.62rem; font-weight: 800; padding: 2px 8px; border-radius: 4px; letter-spacing: 1px; }
  @media (max-width: 640px) {
    .mt-row { flex-wrap: wrap; row-gap: 0.3rem; }
    .mt-row__main { flex-basis: 100%; }
  }
</style>