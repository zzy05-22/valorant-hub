---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CrosshairPreview from '../../components/CrosshairPreview.astro';
import { getCollection } from 'astro:content';
import proSettingsData from '../../data/pro-settings.json';

// 选手灵敏度联动：pro-settings.json 与 pro-*.json 准星卡按 id 关联，查证到的才显示（宁缺毋假）
type Sens = { dpi?: number; sens?: number; edpi: number; note?: string };
const sensMap = (proSettingsData as { players: Record<string, Sens> }).players;
const sensOf = (cardId: string): Sens | undefined => sensMap[cardId.replace(/^pro-/, '')];
const sensTitle = (s: Sens) => (s.dpi && s.sens ? `${s.dpi} DPI × ${s.sens} ≈ ${s.edpi} edpi` : (s.note ?? `${s.edpi} edpi`));

const crosshairs = await getCollection('crosshairs');
const proCrosshairs = crosshairs.filter((c) => c.data.tags.includes('职业选手'));
const officialCrosshairs = crosshairs.filter((c) => c.data.tags.includes('官方站精选'));
const classicCrosshairs = crosshairs.filter((c) => !c.data.tags.includes('职业选手') && !c.data.tags.includes('官方站精选'));
---
<BaseLayout title="准星库｜无畏契约资料站" description="热门准星代码合集：SVG 实时预览、一键复制，游戏内导入即用">
  <PageHero label="Crosshairs" title="准星库" subtitle={`${crosshairs.length} 个准星 · 经典 ${classicCrosshairs.length} · 选手 ${proCrosshairs.length} · 官方站 ${officialCrosshairs.length}`} />
  <main class="container section">
    <section class="role-group">
      <h2>导入方法</h2>
      <p class="xh-howto">
        游戏内 <b>设置 → 十字准星 → 准星配置</b> → 点击 <b>导入配置代码</b> → 粘贴本页任意准星的代码 → 确定。想分享自己的准星？同样页面点击<b>复制配置代码</b>。
      </p>
    </section>
    <section class="role-group">
      <h2>经典准星</h2>
      <div class="xh-grid">
        {classicCrosshairs.map((c) => (
          <div class="card-cut xh-card">
            <div class="xh-card__preview"><CrosshairPreview code={c.data.code} size={72} /></div>
            <div class="xh-card__info">
              <b>{c.data.name}</b>
              <div class="xh-card__tags">{c.data.tags.map((t) => <span>{t}</span>)}{sensOf(c.id) && <span class="xh-card__sens" title={sensTitle(sensOf(c.id)!)}>{sensOf(c.id)!.edpi} edpi</span>}</div>
              <p>{c.data.note}</p>
            </div>
            <div class="xh-card__code">
              <code>{c.data.code}</code>
              <button type="button" class="btn btn-primary xh-copy" data-code={c.data.code}>复制代码</button>
            </div>
          </div>
        ))}
      </div>
    </section>
    <section class="role-group">
      <h2>职业选手准星</h2>
      <p class="xh-howto">准星与灵敏度来自社区公开资料（2026-10 整理，多来源交叉验证；灵敏度标签悬停可见 DPI 与游戏内灵敏度明细），选手会随时间更换设置，以其实际为准。</p>
      <div class="xh-grid">
        {proCrosshairs.map((c) => (
          <div class="card-cut xh-card">
            <div class="xh-card__preview"><CrosshairPreview code={c.data.code} size={72} /></div>
            <div class="xh-card__info">
              <b>{c.data.name}</b>
              <div class="xh-card__tags">{c.data.tags.map((t) => <span>{t}</span>)}{sensOf(c.id) && <span class="xh-card__sens" title={sensTitle(sensOf(c.id)!)}>{sensOf(c.id)!.edpi} edpi</span>}</div>
              <p>{c.data.note}</p>
            </div>
            <div class="xh-card__code">
              <code>{c.data.code}</code>
              <button type="button" class="btn btn-primary xh-copy" data-code={c.data.code}>复制代码</button>
            </div>
          </div>
        ))}
      </div>
    </section>
    <section class="role-group">
      <h2>官方站精选</h2>
      <p class="xh-howto">来自腾讯 WeGame 官方准星站收录的通用款（2026-10 整理），自定义配色系为主。</p>
      <div class="xh-grid">
        {officialCrosshairs.map((c) => (
          <div class="card-cut xh-card">
            <div class="xh-card__preview"><CrosshairPreview code={c.data.code} size={72} /></div>
            <div class="xh-card__info">
              <b>{c.data.name}</b>
              <div class="xh-card__tags">{c.data.tags.map((t) => <span>{t}</span>)}{sensOf(c.id) && <span class="xh-card__sens" title={sensTitle(sensOf(c.id)!)}>{sensOf(c.id)!.edpi} edpi</span>}</div>
              <p>{c.data.note}</p>
            </div>
            <div class="xh-card__code">
              <code>{c.data.code}</code>
              <button type="button" class="btn btn-primary xh-copy" data-code={c.data.code}>复制代码</button>
            </div>
          </div>
        ))}
      </div>
    </section>
    <p class="data-meta">准星由社区整理；预览为参数近似渲染，实际以游戏内效果为准。想上架你的准星？在 src/content/crosshairs/ 加一个 JSON 即可。</p>
  </main>
</BaseLayout>

<script>
  // 复制按钮（纯增强：无 JS 时页面完整，仅复制不可用）
  const btns = document.querySelectorAll<HTMLButtonElement>('.xh-copy');
  btns.forEach((b) => {
    b.addEventListener('click', async () => {
      const code = b.dataset.code ?? '';
      try {
        await navigator.clipboard.writeText(code);
        b.textContent = '已复制 ✓';
      } catch {
        // clipboard 不可用时退化为选中代码文本
        const codeEl = b.parentElement?.querySelector('code');
        if (codeEl) {
          const range = document.createRange();
          range.selectNodeContents(codeEl);
          const sel = getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
          b.textContent = '已选中，Ctrl+C 复制';
        }
      }
      setTimeout(() => { b.textContent = '复制代码'; }, 1500);
    });
  });
</script>

<style>
  .xh-howto { color: var(--val-gray); max-width: 46em; font-size: 0.9rem; line-height: 1.8; }
  .xh-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  @media (max-width: 768px) { .xh-grid { grid-template-columns: 1fr; } }
  .xh-card { padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.8rem; min-width: 0; }
  .xh-card__preview { background: rgba(236, 232, 225, 0.04); border-radius: 12px; padding: 0.8rem; display: flex; align-items: center; justify-content: center; }
  .xh-card__info b { color: var(--val-cream); font-size: 1rem; display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .xh-card__tags { display: flex; gap: 0.4rem; margin: 0.35rem 0; flex-wrap: nowrap; overflow: hidden; }
  .xh-card__tags span { background: rgba(255, 70, 85, 0.12); color: var(--val-red); font-size: 0.65rem; font-weight: 700; padding: 2px 7px; border-radius: 4px; }
  .xh-card__tags .xh-card__sens { background: rgba(24, 229, 245, 0.08); color: #18E5F5; border: 1px solid rgba(24, 229, 245, 0.35); }
  .xh-card__info p { color: var(--val-gray); font-size: 0.82rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 3.2em; }
  .xh-card__code { display: flex; align-items: center; gap: 0.6rem; margin-top: auto; }
  .xh-card__code code { flex: 1; min-width: 0; font-family: ui-monospace, monospace; font-size: 0.68rem; color: var(--val-gray); background: rgba(236, 232, 225, 0.04); padding: 0.5rem 0.6rem; overflow-x: auto; white-space: nowrap; }
  .xh-copy { font-size: 0.72rem; padding: 0.5rem 0.9rem; white-space: nowrap; }
</style>