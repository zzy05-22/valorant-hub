---
import BaseLayout from '../../layouts/BaseLayout.astro';
import mapsData from '../../data/maps.json';
import { getCollection, render as renderGuide } from 'astro:content';
import LineupPanel from '../../components/LineupPanel.astro';
import { translateCallouts } from '../../utils/callouts';

export function getStaticPaths() {
  return mapsData.maps.map((map) => ({ params: { id: map.id }, props: { map } }));
}
const { map } = Astro.props;
const name = map.zh.name !== map.en.name ? `${map.zh.name} ${map.en.name}` : map.en.name;

// 查找该地图的攻略（有则渲染全文，无则显示占位说明）
const allGuides = await getCollection('mapGuides', ({ data }) => !data.draft);
const guideEntry = allGuides.find((g) => g.data.mapId === map.id) ?? null;
const GuideContent = guideEntry ? (await renderGuide(guideEntry)).Content : null;

// 报点速查：官方 callouts 按 zone 分组 + 中文通行叫法对照（未收录保留英文原文）
const callouts = map.callouts ?? [];
const translated = translateCallouts(callouts);
const ZONE_LABEL: Record<string, string> = {
  A: 'A 区', B: 'B 区', C: 'C 区', Mid: '中路',
  'Attacker Side': '攻方', 'Defender Side': '守方',
};
const ZONE_ORDER = ['A', 'B', 'C', 'Mid', 'Attacker Side', 'Defender Side'];
const PREFIX_ZONE = new Set(['A', 'B', 'C']);
const calloutGroups = ZONE_ORDER
  .map((zone) => {
    const items: { en: string; zh: string }[] = [];
    callouts.forEach((c, i) => {
      if (c.zone !== zone) return;
      items.push({
        en: PREFIX_ZONE.has(c.zone) ? `${c.zone} ${c.region}` : c.region,
        zh: translated[i].zh,
      });
    });
    return { zone, items };
  })
  .filter((g) => g.items.length > 0);

// 报点地图标注：世界坐标 → 战术图百分比（各图官方战术图朝向不统一，逐图独立变换）
// 标定方式：13 张竞技图以「人工修正过的 lineups 真值 + 攻守出生点方位 + 地图形状/包点方位」三重约束标定
// 未列入的非竞技图用默认变换，标记可能存在偏移
const MAP_TRANSFORM: Record<string, (nx: number, ny: number) => [number, number]> = {
  ascent: (a, b) => [1 - a, b],        // 镜像x（lineups 真值标定）
  split: (a, b) => [1 - a, b],         // A 左 B 右 攻下守上
  haven: (a, b) => [1 - a, b],         // 三点横排 A 左 B 中 C 右
  icebox: (a, b) => [a, 1 - b],        // 镜像y（A 左 B 右 攻下守上）
  abyss: (a, b) => [1 - a, 1 - b],    // 180°（lineups 真值标定）
  corrode: (a, b) => [1 - a, 1 - b],  // 180°（lineups 真值标定）
  bind: (a, b) => [1 - b, a],         // cw90（lineups 真值标定）
  fracture: (a, b) => [1 - b, a],     // cw90（lineups 真值标定）
  summit: (a, b) => [1 - b, a],       // cw90（lineups 真值标定）
  sunset: (a, b) => [1 - b, 1 - a],   // 180t（lineups 真值标定）
  breeze: (a, b) => [1 - b, 1 - a],   // A 左 B 右 攻下守上
  lotus: (a, b) => [1 - b, 1 - a],    // 三点横排
  pearl: (a, b) => [1 - b, 1 - a],    // A 左 B 右 攻下守上
};
const defaultTransform = (a: number, b: number): [number, number] => [1 - a, b];
const tf = MAP_TRANSFORM[map.id] ?? defaultTransform;
const PAD = 8;
const xs = callouts.map((c) => c.x), ys = callouts.map((c) => c.y);
const minX = Math.min(...xs), maxX = Math.max(...xs);
const minY = Math.min(...ys), maxY = Math.max(...ys);
const spanX = maxX - minX || 1, spanY = maxY - minY || 1;
const ZONE_COLOR: Record<string, string> = {
  A: '#FF4655', B: '#18E5F5', C: '#B046FF', Mid: '#FFD54A',
  'Attacker Side': '#7FDB8A', 'Defender Side': '#ECE8E1',
};
const calloutMarkers = callouts.map((c, i) => {
  const [lx, ty] = tf((c.x - minX) / spanX, (c.y - minY) / spanY);
  return {
    zone: c.zone,
    zh: translated[i].zh,
    left: PAD + lx * (100 - PAD * 2),
    top: PAD + ty * (100 - PAD * 2),
  };
});
---
<BaseLayout
  title={`${name}｜无畏契约资料站`}
  description={`${name}：官方战术图与背景设定。${(map.zh.tacticalDescription || '').slice(0, 50)}`}
>
  <main class="container section">
    <a class="back" href="/maps/">← 返回地图库</a>
    <div class="label-cut">{map.coordinates}</div>
    <h1>{name}</h1>
    <img class="m-img" src={map.displayIcon} alt={name} onerror="this.src='/favicon.svg'" />
    {map.zh.tacticalDescription && <h2>战术要点</h2>}
    {map.zh.tacticalDescription && <p class="m-text">{map.zh.tacticalDescription}</p>}
    {map.zh.description && <h2>背景设定</h2>}
    {map.zh.description && <p class="m-text">{map.zh.description}</p>}
    <h2>点位图示</h2>
    <LineupPanel mode="map" focusId={map.id} />
    {calloutGroups.length > 0 && (
      <>
        <h2>报点速查</h2>
        <p class="page-sub">标注图与文字表数据同源（官方 callout + 中文通行叫法）；通用译名整理中，未收录的以英文原名沟通即可</p>
        <div class="co-map card-cut">
          <img class="co-map__img" src={map.displayIcon} alt={`${name} 报点标注`} loading="lazy" />
          {calloutMarkers.map((m) => (
            <span class="co-marker" style={`left:${m.left.toFixed(1)}%;top:${m.top.toFixed(1)}%;--c:${ZONE_COLOR[m.zone] ?? '#ECE8E1'}`}>
              <i></i><b>{m.zone === 'Attacker Side' ? '攻方 ' : m.zone === 'Defender Side' ? '守方 ' : ''}{m.zh}</b>
            </span>
          ))}
        </div>
        <div class="co-grid">
          {calloutGroups.map((g) => (
            <div class="card-cut co-zone">
              <h3>{ZONE_LABEL[g.zone] ?? g.zone}</h3>
              <ul>
                {g.items.map((it) => (
                  <li class="co-item"><span class="co-en">{it.en}</span><span class="co-zh">{it.zh}</span></li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </>
    )}
    <h2>攻防思路</h2>
    {GuideContent ? (
      <article class="prose m-guide"><GuideContent /></article>
    ) : (
      <p class="m-text">社区攻防思路编写中，本页先呈现官方战术图与点位图示。</p>
    )}
    <p class="data-meta">数据版本 {mapsData.version}</p>
  </main>
</BaseLayout>

<style>
  .m-img { width: 100%; max-width: 640px; margin: 1.2rem 0; border: 1px solid var(--val-line); }
  .m-text { color: var(--val-gray); max-width: 46em; margin-bottom: 1rem; }
  .m-guide { max-width: 46em; }
  .co-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.8rem; }
  .co-zone { padding: 0.8rem 1rem; }
  .co-zone h3 { color: var(--val-red); font-size: 0.8rem; letter-spacing: 0.12em; margin-bottom: 0.55rem; }
  .co-zone ul { list-style: none; display: grid; gap: 0.35rem; }
  .co-item { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; font-size: 0.82rem; line-height: 1.5; }
  .co-en { color: var(--val-cream); }
  .co-zh { color: var(--val-red); font-weight: 700; text-align: right; flex-shrink: 0; }
  .co-map { position: relative; margin-bottom: 1.2rem; overflow: hidden; }
  .co-map__img { display: block; width: 100%; }
  .co-marker { position: absolute; transform: translate(-50%, -50%); display: flex; align-items: center; gap: 0.28rem; z-index: 2; }
  .co-marker i { width: 10px; height: 10px; border-radius: 50%; background: var(--c); box-shadow: 0 0 9px var(--c); border: 1.5px solid rgba(15, 25, 35, 0.85); flex-shrink: 0; transition: transform 0.15s ease; }
  .co-marker b { color: var(--val-cream); font-size: 0.58rem; font-weight: 600; background: rgba(15, 25, 35, 0.78); padding: 1px 5px; border-radius: 3px; white-space: nowrap; opacity: 0.85; transition: opacity 0.15s ease; }
  .co-marker:hover i { transform: scale(1.4); }
  .co-marker:hover b { opacity: 1; color: var(--c); box-shadow: 0 0 8px rgba(0, 0, 0, 0.6); }
</style>